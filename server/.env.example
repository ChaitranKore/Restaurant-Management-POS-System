# Copy this file to .env and adjust as needed.
# Running `npm run setup` will auto-generate a .env with safe defaults
# (including a random JWT secret) if one does not already exist.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_pos

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Comma separated list of origins allowed to call the API / connect via sockets
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Default admin account created by `npm run setup`
DEFAULT_ADMIN_NAME=Restaurant Admin
DEFAULT_ADMIN_EMAIL=admin@restaurant.local
DEFAULT_ADMIN_PASSWORD=Admin@123
